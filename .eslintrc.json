{
  "root": true,
  "env": { "node": true, "es2021": true },
  "parserOptions": { "ecmaVersion": 2021, "sourceType": "script" },
  "extends": "eslint:recommended",
  "rules": {
    "no-unused-vars": "off",
    "no-empty": "off",
    "no-console": "off",
    "no-constant-condition": "off",
    "no-prototype-builtins": "off"
  }
}
